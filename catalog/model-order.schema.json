{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zenith Relay model display order",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "revision", "ignoredSuffixes", "providers"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "revision": {"type": "string", "minLength": 1},
    "ignoredSuffixes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^-[a-z-]+$"}
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "aliases", "patterns", "families"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "aliases": {"$ref": "#/$defs/aliases"},
          "patterns": {"$ref": "#/$defs/patterns"},
          "families": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "patterns", "classes", "variants"],
              "properties": {
                "id": {"$ref": "#/$defs/id"},
                "patterns": {"$ref": "#/$defs/patterns"},
                "classes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "aliases"],
                    "properties": {
                      "id": {"$ref": "#/$defs/id"},
                      "aliases": {"$ref": "#/$defs/aliases"}
                    }
                  }
                },
                "variants": {"$ref": "#/$defs/strings"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"}
    },
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "patterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2}
    }
  }
}
