{
  "name": "zenith-relay",
  "version": "1.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b tsconfig.json && vite build",
    "check": "tsc -b tsconfig.json --pretty false",
    "test:unit": "bun test tests/i18n.test.ts tests/modelPricing.test.ts tests/usageSpeed.test.ts",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --config playwright.docs.config.ts",
    "clean": "bun ../.github/tools/clean.mjs",
    "clean:all": "bun ../.github/tools/clean.mjs --all",
    "verify": "bun run check && bun run test:unit && bun run build && cargo test --manifest-path ../src-tauri/Cargo.toml --locked -- --test-threads=1",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "tauri": "tauri",
    "app:dev": "bun ../.github/tools/tauri-dev.mjs",
    "app:build": "bun ../.github/tools/tauri-build.mjs",
    "app:build:signed": "bun ../.github/tools/tauri-build.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
