{
  "name": "zenith-relay",
  "version": "1.1.5",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "setup": "bun ../scripts/setup/setup-dev.mjs",
    "setup:browsers": "bun ../scripts/setup/setup-dev.mjs --with-browsers",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b tsconfig.json && vite build",
    "check": "tsc -b tsconfig.json --pretty false",
    "check:bundle-size": "bun ../scripts/check/check-frontend-bundle.mjs",
    "check:guardrails": "bun ../scripts/check/check-agent-guardrails.mjs",
    "check:duplicates": "bun ../scripts/check/check-duplicate-code.mjs",
    "test:unit": "bun test tests --path-ignore-patterns=\"tests/e2e/**\" --path-ignore-patterns=\"tests/docs/**\"",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --config playwright.docs.config.ts",
    "clean": "bun ../scripts/maintenance/clean.mjs",
    "clean:all": "bun ../scripts/maintenance/clean.mjs --all",
    "verify": "bun run test:unit && bun run build && bun run check:bundle-size && cargo test --manifest-path ../src-tauri/Cargo.toml --locked -- --test-threads=1",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "app:dev": "bun ../scripts/build/tauri-dev.mjs",
    "app:build": "bun ../scripts/build/tauri-build.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "i18next": "^26.4.2",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
